# Banco de dados (docker compose up -d) — porta 5433 para não conflitar com um Postgres local
DATABASE_URL="postgresql://farmsense:farmsense@localhost:5433/farmsense"
REDIS_URL="redis://localhost:6379"

# Better Auth — gere o secret com: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# E-mail (SMTP)
# Opção A — caixa de teste local (Mailpit do docker compose): os e-mails NÃO saem de verdade,
# ficam em http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="FarmSense <nao-responda@farmsense.local>"

# Opção B — envio real pelo Gmail (sem domínio). Comente a opção A e descomente abaixo.
# SMTP_PASS é uma "senha de app" (https://myaccount.google.com/apppasswords), não a senha da conta.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="seuemail@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# EMAIL_FROM="FarmSense <seuemail@gmail.com>"

# Login com Google (opcional — o botão só aparece quando os dois estão preenchidos)
# Crie em https://console.cloud.google.com/apis/credentials → "ID do cliente OAuth" → Aplicativo da Web
# URI de redirecionamento autorizado: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
