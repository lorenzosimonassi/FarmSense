generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modelos usados pelo Better Auth (https://www.better-auth.com/docs/concepts/database)

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  propriedade   Propriedade?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Domínio do FarmSense

enum Atividade {
  PECUARIA
  AGRICULTURA
}

enum TipoRebanho {
  CORTE
  LEITE
  MISTO
}

model Propriedade {
  id          String         @id @default(cuid())
  userId      String         @unique
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome        String
  municipio   String
  uf          String         @db.Char(2)
  areaTotalHa Decimal?       @db.Decimal(10, 2)
  atividades  Atividade[]
  tipoRebanho TipoRebanho?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  animais     Animal[]
  talhoes     Talhao[]
  limite      LimiteFazenda?

  @@map("propriedade")
}

// Perímetro da fazenda importado do CAR. Fica fora de Propriedade porque pode ter milhares de pontos,
// e a fazenda é lida em toda requisição do painel
model LimiteFazenda {
  id            String      @id @default(cuid())
  propriedadeId String      @unique
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  // Um anel por gleba: [[[lng, lat], ...], ...], cada anel sem repetir o primeiro ponto
  contornos     Json
  areaHa        Decimal     @db.Decimal(10, 2)
  codigoCar     String?
  // Nome do arquivo importado, para o produtor saber de onde veio o contorno
  arquivo       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("limite_fazenda")
}

enum Sexo {
  MACHO
  FEMEA
}

enum SituacaoAnimal {
  ATIVO
  VENDIDO
  MORTO
}

model Animal {
  id             String               @id @default(cuid())
  propriedadeId  String
  propriedade    Propriedade          @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  // Brinco, tatuagem ou número de registro: o que o produtor usa para reconhecer o animal
  identificacao  String
  nome           String?
  sexo           Sexo
  raca           String?
  dataNascimento DateTime?            @db.Date
  lote           String?
  situacao       SituacaoAnimal       @default(ATIVO)
  dataSaida      DateTime?            @db.Date
  observacoes    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  pesagens       Pesagem[]
  aplicacoes     AplicacaoSanitaria[]

  @@unique([propriedadeId, identificacao])
  @@index([propriedadeId, situacao])
  @@map("animal")
}

model Pesagem {
  id         String   @id @default(cuid())
  animalId   String
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  data       DateTime @db.Date
  pesoKg     Decimal  @db.Decimal(7, 2)
  observacao String?
  createdAt  DateTime @default(now())

  // Uma pesagem por animal por dia; o índice também serve às consultas por data
  @@unique([animalId, data])
  @@index([data])
  @@map("pesagem")
}

enum TipoAplicacao {
  VACINA
  VERMIFUGO
  MEDICAMENTO
  OUTRO
}

model AplicacaoSanitaria {
  id            String        @id @default(cuid())
  animalId      String
  animal        Animal        @relation(fields: [animalId], references: [id], onDelete: Cascade)
  tipo          TipoAplicacao
  produto       String
  dose          String?
  dataAplicacao DateTime      @db.Date
  // Informada em cada aplicação; é dela que saem os alertas de reforço
  proximaDose   DateTime?     @db.Date
  observacao    String?
  createdAt     DateTime      @default(now())

  @@index([animalId, produto])
  @@index([proximaDose])
  @@map("aplicacao_sanitaria")
}

model Talhao {
  id            String      @id @default(cuid())
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  nome          String
  areaHa        Decimal     @db.Decimal(10, 2)
  // Contorno desenhado no mapa: anel do polígono GeoJSON, [[lng, lat], ...] sem repetir o primeiro ponto
  contorno      Json?
  observacoes   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  plantios      Plantio[]

  @@unique([propriedadeId, nome])
  @@map("talhao")
}

enum UnidadeColheita {
  SC
  T
  KG
}

// Um ciclo de uma cultura num talhão, do plantio à colheita. O status (planejado, em andamento, colhido) é calculado
model Plantio {
  id                String           @id @default(cuid())
  talhaoId          String
  talhao            Talhao           @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  cultura           String
  variedade         String?
  dataPlantio       DateTime         @db.Date
  previsaoColheita  DateTime?        @db.Date
  dataColheita      DateTime?        @db.Date
  quantidadeColhida Decimal?         @db.Decimal(12, 2)
  unidade           UnidadeColheita?
  observacoes       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([talhaoId, dataPlantio])
  @@map("plantio")
}
